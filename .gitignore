# Datasets and downloads.
# NOTE: anchored with a leading slash on purpose. An unanchored `data/` matches at ANY
# depth, so it also matched src/hsat/data/ and silently kept the entire data package
# out of the repository.
/data/
/cnf/
/aslib_data/
/benchmarks/
*.cnf
*.cnf.gz
*.cnf.bz2
*.cnf.xz
*.arff

# Models, caches, logs
/checkpoints/
/runs/
/logs/
/wandb/
/cache/
*.pt
*.pth
*.ckpt

# Solver builds
/solvers/
/scripts/build/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
*.egg-info/
/build/
/dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Sync bundles handed over from the cloud session
*.bundle

# OS / editor
.DS_Store
.vscode/
.idea/
